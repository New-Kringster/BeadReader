# Copy to .env.local and fill in. See README.md for where each value comes from.

# Supabase project API URL (Project Settings → API → Project URL)
SUPABASE_URL=

# Supabase service_role secret key (Project Settings → API). Server-side only — bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Access code for the first admin, used by `npm run bootstrap`.
BOOTSTRAP_ADMIN_CODE=

# Optional: Cloudflare R2 enables webtoon books. Leave every R2 value blank for
# a text-only deployment; the existing Vercel one-click flow will still work.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public custom-domain origin for the bucket, without a trailing slash.
R2_PUBLIC_BASE_URL=
